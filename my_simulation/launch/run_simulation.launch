<launch>
  <arg name="gui" default="true"/>
  <!-- All sensors, mapping and planning use the Gazebo clock. -->
  <param name="/use_sim_time" value="true" />

  <!-- 2. 设置世界 -->
  <arg name="world_name" default="$(find aws_robomaker_small_warehouse_world)/worlds/no_roof_small_warehouse.world"/>
  
  <!-- 3. 启动 Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- 4. 加载机器人 -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find my_simulation)/urdf/my_robot.xacro'" />

  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -model my_robot -x 2.0 -y 2.0 -z 0.2 -param robot_description" />

  <!-- 5. 状态发布 -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  
  <!-- robot_state_publisher owns base_link -> velodyne from the URDF. -->


  <!-- pathFollower/guard already publish geometry_msgs/Twist. -->
</launch>
